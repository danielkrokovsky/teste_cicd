pipeline {
    agent any

    // Utiliza as ferramentas configuradas anteriormente no JCasC
    tools {
        jdk 'JDK-21'
        maven 'maven'
    }

    environment {
        // Nome da instalação do Sonar declarada no jenkins.yaml
        SONAR_SERVER = 'SonarQube'
    }

    stages {
        stage('Compilação e Testes') {
            steps {
                echo 'Rodando a partir do arquivo Jenkinsfile'
                echo 'Compilando Spring Boot e executando testes com JaCoCo...'
                sh 'mvn -f oficina/pom.xml verify jacoco:report'
            }
            post {
                always {
                    // Publica relatório de testes unitários
                    junit testResults: '**/target/surefire-reports/*.xml', allowEmptyResults: true

                    // Publica cobertura do JaCoCo no Jenkins
                    jacoco(
                        execPattern: '**/target/*.exec',
                        classPattern: '**/target/classes',
                        sourcePattern: '**/src/main/java'
                    )
                }
            }
        }

        /* stage('Sonar_qube') {
                    steps {
                        echo 'Enviando métricas para o SonarQube...'
                        // Utiliza a instalação configurada no JCasC / Jenkins global
                        withSonarQubeEnv('SonarQube') {
                            withCredentials([string(credentialsId: 'sonar-token-java', variable: 'SONAR_TOKEN')]) {
                                sh '''
                                    mvn -f oficina/pom.xml \
                                        org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                                        -Dsonar.projectKey=spring-boot-app \
                                        -Dsonar.token=${SONAR_TOKEN} \
                                        -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                                '''
                            }
                        }
                    }
                }

                stage('Quality Gate') {
                    steps {
                        timeout(time: 2, unit: 'MINUTES') {
                            // Aguarda o webhook configurado no SonarQube avisar o Jenkins
                            waitForQualityGate(abortPipeline: true)
                        }
                    }
                }
 */
        stage('Gerar JAR Spring Boot') {
            steps {
                sh 'mvn -f oficina/pom.xml package -DskipTests'
                archiveArtifacts artifacts: '**/target/*.jar', allowEmptyArchive: false
            }
        }
    }
}